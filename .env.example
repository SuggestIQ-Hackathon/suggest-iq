# Copy to .env (never commit .env). Tests ignore these and always run offline (mock mode).
LLM_MODE=mock                       # mock | live
LLM_MODEL=anthropic/claude-sonnet-5-5   # any LiteLLM model string
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODE=hash                 # hash | local | litellm
EMBEDDING_MODEL=text-embedding-3-small   # used when EMBEDDING_MODE=litellm
REAL_DOMAINS=auto                   # auto | none | all | technology,clinical,sec,corporate_responsibility
